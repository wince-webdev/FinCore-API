# Modèle d'environnement — copier vers `.env` puis personnaliser :
#   copy .env.example .env      (PowerShell : Copy-Item .env.example .env)
#
# ⚠️  Le fichier `.env` est ignoré par Git : jamais de secret dans l'historique.
# Spring Boot le charge via spring.config.import (application.yml).
# Docker Compose le lit automatiquement pour POSTGRES_*.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=fincore
POSTGRES_USER=fincore
POSTGRES_PASSWORD=CHANGE_MOI_mot_de_passe_local
# 5433 : Laragon utilise déjà le 5432 (voir GUIDE_DETAILLE, piège §Phase 0)
POSTGRES_PORT=5433

# --- Application (application.yml) ---
# URL JDBC utilisée par l'application en profil dev (localhost:5433)
FINCORE_DB_URL=jdbc:postgresql://localhost:5433/fincore
FINCORE_DB_USERNAME=fincore
FINCORE_DB_PASSWORD=CHANGE_MOI_mot_de_passe_local

# --- Sécurité (phase 2 : F-01) ---
# Secret de signature JWT — au moins 256 bits (32 octets).
# Générer : openssl rand -base64 48
# SANS cette variable, l'app démarre avec le secret « dev » (voir
# application.yml) — jamais acceptable en production.
FINCORE_JWT_SECRET=CHANGE_MOI_generer_un_secret_de_plus_de_32_octets
